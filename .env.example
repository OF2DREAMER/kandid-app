# =====================================================================
# KANDID PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================

# Environment (development / production)
ENVIRONMENT=development

# Server Port & URLs
PORT=8080
APP_URL=http://localhost:8080

# Security
# In production, SESSION_SECRET must be a generated 32-byte cryptographic secret (e.g. run: openssl rand -hex 32)
SESSION_SECRET=
INTERNAL_OPS_SECRET=

# =====================================================================
# 1. DATABASE (PostgreSQL / Supabase)
# Production: postgresql://postgres:password@host:5432/postgres
# Development fallback: Embedded SQLite (data/kandid.db)
# =====================================================================
DATABASE_URL=

# =====================================================================
# 2. MEDIA STORAGE (Cloudinary - 25GB Free Tier)
# Sign up at: https://cloudinary.com
# =====================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# =====================================================================
# 3. TRANSACTIONAL EMAIL & OTP (Resend - 100-300 Free Emails/Day)
# Sign up at: https://resend.com
# =====================================================================
RESEND_API_KEY=
FROM_EMAIL=Kandid <onboarding@resend.dev>

# =====================================================================
# 4. GOOGLE OAUTH
# Google Cloud Console OAuth 2.0 Client ID for server-side ID token verification
# =====================================================================
GOOGLE_CLIENT_ID=
